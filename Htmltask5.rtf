(CSS) External \par
 \{\par
    margin: 0;\par
    padding: 0;\par
    box-sizing: border-box;\par
    font-family: Arial, sans-serif;\par
\}\par
\par
body \{\par
    background-color: #f4f6f9;\par
    color: #333333;\par
    line-height: 1.6;\par
\}\par
\par
.main-header \{\par
    background-color: #1e3a8a;\par
    color: #ffffff;\par
    text-align: center;\par
    padding: 2rem 1rem;\par
\}\par
\par
.content \{\par
    display: flex;\par
    justify-content: center;\par
    padding: 2rem;\par
\}\par
\par
.card \{\par
    background-color: #ffffff;\par
    padding: 2rem;\par
    border-radius: 8px;\par
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\par
    max-width: 500px;\par
\}\par
\par
.card h2 \{\par
    margin-bottom: 0.75rem;\par
    color: #1e3a8a;\par
\}\par
\par
.btn \{\par
    margin-top: 1rem;\par
    padding: 0.6rem 1.2rem;\par
    background-color: #2563eb;\par
    color: #ffffff;\par
    border: none;\par
    border-radius: 4px;\par
    cursor: pointer;\par
\}\par
\par
.btn:hover \{\par
    background-color: #1d4ed8;\par
\}\par

