[CSS] EXTERNAL \par
* \{\par
  box-sizing: border-box;\par
  margin: 0;\par
  padding: 0;\par
\}\par
\par
body \{\par
  background-color: #121212;\par
  padding: 2rem;\par
  font-family: system-ui, -apple-system, sans-serif;\par
\}\par
\par
.gallery-container \{\par
  max-width: 1200px;\par
  margin: 0 auto;\par
  display: grid;\par
  /* Creates as many columns as fit, each at least 250px wide */\par
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\par
  /* Sets a consistent base height for rows */\par
  grid-auto-rows: 250px;\par
  /* Fills in empty grid holes automatically when spanning items */\par
  grid-auto-flow: dense;\par
  gap: 1rem;\par
\}\par
\par
.gallery-item \{\par
  position: relative;\par
  overflow: hidden;\par
  border-radius: 8px;\par
  background-color: #2a2a2a;\par
\}\par
\par
.gallery-item img \{\par
  width: 100%;\par
  height: 100%;\par
  /* Prevents image distortion regardless of container aspect ratio */\par
  object-fit: cover;\par
  display: block;\par
  transition: transform 0.35s ease;\par
\}\par
\par
.gallery-item:hover img \{\par
  transform: scale(1.06);\par
\}\par
\par
/* Spanning classes for visual variety on larger screens */\par
@media (min-width: 600px) \{\par
  .wide \{\par
    grid-column: span 2;\par
  \}\par
\par
  .tall \{\par
    grid-row: span 2;\par
  \}\par
\par
  .big \{\par
    grid-column: span 2;\par
    grid-row: span 2;\par
  \}\par
\}\par

