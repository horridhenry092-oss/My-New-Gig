\par
  <style>\par
    \par
    :root \{\par
      --bg-deep: #0F0B29;\par
      --saffron: #FF6B1A;\par
      --marigold: #FFB800;\par
      --crimson: #D91E48;\par
      --gold: #F3C65F;\par
    \}\par
\par
    body \{\par
      background-color: var(--bg-deep);\par
      color: #FFF9F0;\par
      overflow-x: hidden;\par
    \}\par
    .mandala-bg \{\par
      background-image:\par
        radial-gradient(circle at 20% 20%, rgba(255, 107, 26, 0.14) 0%, transparent 45%),\par
        radial-gradient(circle at 80% 30%, rgba(217, 30, 72, 0.14) 0%, transparent 45%),\par
        radial-gradient(circle at 50% 85%, rgba(255, 184, 0, 0.10) 0%, transparent 50%);\par
    \}\par
\par
    @keyframes spinSlow \{\par
      from \{ transform: rotate(0deg); \}\par
      to \{ transform: rotate(360deg); \}\par
    \}\par
    @keyframes spinReverseSlow \{\par
      from \{ transform: rotate(360deg); \}\par
      to \{ transform: rotate(0deg); \}\par
    \}\par
\par
    .animate-mandala-cw \{\par
      animation: spinSlow 48s linear infinite;\par
    \}\par
    .animate-mandala-ccw \{\par
      animation: spinReverseSlow 64s linear infinite;\par
    \}\par
\par
    /* Glowing Diya Flame Flicker Effect */\par
    @keyframes flickerFlame \{\par
      0%, 100% \{\par
        transform: scale(1) rotate(-2deg);\par
        filter: drop-shadow(0 0 12px #FFB800) drop-shadow(0 0 24px #FF6B1A);\par
      \}\par
      25% \{\par
        transform: scale(1.06, 0.96) rotate(2deg);\par
        filter: drop-shadow(0 0 16px #FFD166) drop-shadow(0 0 32px #FF6B1A);\par
      \}\par
      50% \{\par
        transform: scale(0.95, 1.07) rotate(-1deg);\par
        filter: drop-shadow(0 0 10px #FFB800) drop-shadow(0 0 20px #D91E48);\par
      \}\par
      75% \{\par
        transform: scale(1.04, 0.98) rotate(3deg);\par
        filter: drop-shadow(0 0 18px #FFE082) drop-shadow(0 0 34px #FF6B1A);\par
      \}\par
    \}\par
\par
    .diya-flame \{\par
      transform-origin: 50% 90%;\par
      animation: flickerFlame 2.4s ease-in-out infinite;\par
    \}\par
\par
    /* Ambient Halo Pulse */\par
    @keyframes haloPulse \{\par
      0%, 100% \{ opacity: 0.45; transform: scale(1); \}\par
      50% \{ opacity: 0.85; transform: scale(1.15); \}\par
    \}\par
    .diya-halo \{\par
      animation: haloPulse 3s ease-in-out infinite;\par
    \}\par
\par
    @keyframes floatUp \{\par
      0% \{\par
        transform: translateY(100vh) rotate(0deg) scale(0.8);\par
        opacity: 0;\par
      \}\par
      15% \{ opacity: 0.75; \}\par
      85% \{ opacity: 0.6; \}\par
      100% \{\par
        transform: translateY(-10vh) rotate(360deg) scale(1.1);\par
        opacity: 0;\par
      \}\par
    \}\par
    .floating-particle \{\par
      position: fixed;\par
      pointer-events: none;\par
      z-index: 1;\par
      animation: floatUp linear infinite;\par
    \}\par
\par
    /* 3D Perspective Card Tilt & Sheen Effect */\par
    .festival-card-wrapper \{\par
      perspective: 1200px;\par
    \}\par
\par
    .festival-card \{\par
      transform-style: preserve-3d;\par
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease, border-color 0.45s ease;\par
      position: relative;\par
      overflow: hidden;\par
    \}\par
\par
    .festival-card::before \{\par
      content: "";\par
      position: absolute;\par
      inset: 0;\par
      background: linear-gradient(\par
        125deg,\par
        transparent 20%,\par
        rgba(255, 224, 130, 0.16) 45%,\par
        rgba(255, 107, 26, 0.12) 55%,\par
        transparent 80%\par
      );\par
      transform: translateX(-120%);\par
      transition: transform 0.75s ease;\par
      z-index: 20;\par
      pointer-events: none;\par
    \}\par
\par
    .festival-card:hover::before \{\par
      transform: translateX(120%);\par
    \}\par
\par
    .festival-card:hover \{\par
      box-shadow:\par
        0 22px 45px -12px rgba(0, 0, 0, 0.75),\par
        0 0 28px rgba(255, 184, 0, 0.24);\par
      border-color: rgba(243, 198, 95, 0.65);\par
    \}\par
\par
    .festival-card .card-image \{\par
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);\par
    \}\par
\par
    .festival-card:hover .card-image \{\par
      transform: scale(1.08);\par
    \}\par
    .ornate-divider \{\par
      height: 1px;\par
      background: linear-gradient(90deg, transparent, rgba(243, 198, 95, 0.7), rgba(255, 107, 26, 0.9), rgba(243, 198, 95, 0.7), transparent);\par
    \}\par
\par
    /* Scroll Reveal Utility */\par
    .reveal-on-scroll \{\par
      opacity: 0;\par
      transform: translateY(28px);\par
      transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);\par
    \}\par
    .reveal-on-scroll.is-visible \{\par
      opacity: 1;\par
      transform: translateY(0);\par
    \}\par
\par
    /* Custom Scrollbar */\par
    ::-webkit-scrollbar \{\par
      width: 9px;\par
    \}\par
    ::-webkit-scrollbar-track \{\par
      background: #0F0B29;\par
    \}\par
    ::-webkit-scrollbar-thumb \{\par
      background: linear-gradient(180deg, #FF6B1A, #D91E48);\par
      border-radius: 9999px;\par
    \}\par
\par
    \par
    @keyframes modalZoomIn \{\par
      from \{\par
        opacity: 0;\par
        transform: scale(0.94) translateY(16px);\par
      \}\par
      to \{\par
        opacity: 1;\par
        transform: scale(1) translateY(0);\par
      \}\par
    \}\par
    .modal-animate \{\par
      animation: modalZoomIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;\par
    \}\par
  </style>\par
</head>\par
